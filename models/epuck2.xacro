<?xml version="1.0"?>
<robot name="epuck2">

    <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    <material name="light_grey"><color rgba="0.8 0.8 0.8 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="red"><color rgba="0.8 0.0 0 1"/></material>

    <link name="base_link">
	    <visual>
		    <geometry>
			    <cylinder length="0.05" radius="0.035"/>
		    </geometry>
		    <material name="light_grey"/>
	    </visual>
	    <collision>
		    <geometry>
			    <cylinder length="0.05" radius="0.035"/>
		    </geometry>
	    </collision>
	    <inertial>
		    <mass value="0.1"/>
		    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
		    <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.05"/>
	    </inertial>
	    <contact>
		    <lateral_friction value="0.0"/>
	    </contact>
    </link>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.02"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000004"/>
    </inertial>
	<contact>
		<lateral_friction value="10.0"/>
	</contact>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.026 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.02"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000004"/>
    </inertial>
	<contact>
		<lateral_friction value="10.0"/>
	</contact>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.026 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_front">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
	<contact>
		<lateral_friction value="0.0"/>
		<rolling_friction value="0.0"/>
		<spinning_friction value="0.0"/>
	</contact>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.02 0 -0.03" rpy="0 0 0"/>
  </joint>

  <link name="caster_back">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
	<contact>
		<lateral_friction value="0.0"/>
		<rolling_friction value="0.0"/>
		<spinning_friction value="0.0"/>
	</contact>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="-0.02 0 -0.03" rpy="0 0 0"/>
  </joint>
	
	<!-- OCZY -->

    <link name="eye_left">
		<inertial>
			<mass value="0.001"/>
			<inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/>
		</inertial>
	    <visual>
		    <geometry>
			    <sphere radius="0.005"/>
		    </geometry>
		    <material name="black"/>
	    </visual>
		<contact>
			<lateral_friction value="0.0"/>
		</contact>
    </link>

    <joint name="eye_left_joint" type="fixed">
	    <parent link="base_link"/>
	    <child link="eye_left"/>
	    <origin xyz="0.03 0.015 0.015" rpy="0 0 0"/>
    </joint>

    <link name="eye_right">
		<inertial>
			<mass value="0.001"/>
			<inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.0000001"/>
		</inertial>
	    <visual>
		    <geometry>
			    <sphere radius="0.005"/>
		    </geometry>
		    <material name="black"/>
	    </visual>
		<contact>
			<lateral_friction value="0.0"/>
		</contact>
    </link>

    <joint name="eye_right_joint" type="fixed">
	    <parent link="base_link"/>
	    <child link="eye_right"/>
	    <origin xyz="0.03 -0.015 0.015" rpy="0 0 0"/>
    </joint>

</robot>